# Local development only. Production must use the HTTPS App Service URL.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters

# Single resource tenant. B2B users must first be invited into this tenant.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-app-secret
ADMIN_GROUP_IDS=00000000-0000-0000-0000-000000000000

# Private Azure Blob Storage through Managed Identity. Do not use account keys.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=agent-packages
REQUIRE_MALWARE_SCAN=true

# Microsoft Graph application access. Use managed-identity in Azure.
GRAPH_AUTH_MODE=managed-identity
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAIL_SENDER=marketplace-notifications@example.com

# Optional outbound community notifications.
TEAMS_NOTIFICATION_WEBHOOK=
NOTIFICATIONS_JOB_TOKEN=replace-with-at-least-32-random-characters

# Explicit non-production mode. It is ignored when NODE_ENV=production.
DEMO_MODE=true
SEED_EXAMPLES=true
MARKETPLACE_DATA_DIR=.marketplace-data

# Public Azure showcase: no login, shared read-only visitor, Azure Blob required.
PUBLIC_DEMO_MODE=false
DEMO_TENANT_ID=agent-marketplace-demo
