{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "15498339503297372339"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "[format('agent-marketplace-{0}', uniqueString(resourceGroup().id))]",
      "minLength": 2,
      "maxLength": 60,
      "metadata": {
        "description": "Globally unique App Service name"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the demo resources"
      }
    },
    "packageUri": {
      "type": "string",
      "defaultValue": "https://raw.githubusercontent.com/v-khdumi/AgentMarketplace/main/release/agent-marketplace-linux.zip?v=bt-detail-1",
      "metadata": {
        "description": "Prebuilt Linux standalone ZIP published with the repository"
      }
    }
  },
  "variables": {
    "sessionSecret": "[format('{0}{1}{2}', uniqueString(resourceGroup().id, parameters('appName'), subscription().subscriptionId), uniqueString(parameters('appName'), tenant().tenantId), uniqueString(resourceGroup().id, tenant().tenantId))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-plan', parameters('appName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "F1"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('appName')))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "NODE|22-lts",
          "appCommandLine": "node server.js",
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "alwaysOn": false,
          "healthCheckPath": "/api/health",
          "http20Enabled": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('appName')))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}/{1}', parameters('appName'), 'appsettings')]",
      "properties": {
        "NODE_ENV": "production",
        "WEBSITE_NODE_DEFAULT_VERSION": "~22",
        "SCM_DO_BUILD_DURING_DEPLOYMENT": "false",
        "ENABLE_ORYX_BUILD": "false",
        "WEBSITE_RUN_FROM_PACKAGE": "1",
        "NEXTAUTH_URL": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName)]",
        "NEXTAUTH_SECRET": "[variables('sessionSecret')]",
        "PUBLIC_DEMO_MODE": "true",
        "DEMO_TENANT_ID": "agent-marketplace-demo-v3",
        "SEED_EXAMPLES": "true",
        "MARKETPLACE_DATA_DIR": "/tmp/agent-marketplace",
        "REQUIRE_MALWARE_SCAN": "false",
        "NEXT_TELEMETRY_DISABLED": "1"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/extensions",
      "apiVersion": "2021-03-01",
      "name": "[format('{0}/{1}', parameters('appName'), 'onedeploy')]",
      "properties": {
        "packageUri": "[parameters('packageUri')]",
        "type": "zip",
        "clean": true,
        "restart": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
        "[resourceId('Microsoft.Web/sites/config', parameters('appName'), 'appsettings')]"
      ]
    }
  ],
  "outputs": {
    "demoUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName)]"
    }
  }
}