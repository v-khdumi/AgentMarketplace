{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "9279244383107995167"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "metadata": {
        "description": "Globally unique application name"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region"
      }
    },
    "entraClientId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "Microsoft Entra application client ID"
      }
    },
    "entraClientSecret": {
      "type": "securestring",
      "minLength": 1,
      "metadata": {
        "description": "Microsoft Entra application client secret"
      }
    },
    "entraTenantId": {
      "type": "string",
      "defaultValue": "[tenant().tenantId]",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "Resource tenant GUID. B2B guests must be invited into this tenant."
      }
    },
    "nextAuthSecret": {
      "type": "securestring",
      "minLength": 32,
      "metadata": {
        "description": "Random session encryption secret, at least 32 characters"
      }
    },
    "adminGroupIds": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Comma-separated Entra group object IDs with administrator recovery access"
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "B3",
        "S1",
        "P1v3",
        "P2v3"
      ]
    },
    "malwareScanCapGB": {
      "type": "int",
      "defaultValue": 100,
      "minValue": 1,
      "metadata": {
        "description": "Monthly malware scanning limit in GB. Defender for Storage incurs additional charges."
      }
    },
    "graphMailSender": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Exchange Online mailbox used by Microsoft Graph sendMail"
      }
    },
    "teamsNotificationWebhook": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Teams Workflows webhook URL"
      }
    },
    "notificationsJobToken": {
      "type": "securestring",
      "minLength": 32,
      "metadata": {
        "description": "Bearer token used only by the scheduled notification worker"
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id, parameters('appName'))]",
    "storageName": "[format('am{0}', variables('suffix'))]",
    "vaultName": "[format('am-{0}-kv', variables('suffix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-plan', parameters('appName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('skuName')]"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": false,
        "allowSharedKeyAccess": false,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', variables('storageName'), 'default')]",
      "properties": {
        "isVersioningEnabled": true,
        "deleteRetentionPolicy": {
          "enabled": true,
          "days": 14
        },
        "containerDeleteRetentionPolicy": {
          "enabled": true,
          "days": 14
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}/{2}', variables('storageName'), 'default', 'agent-packages')]",
      "properties": {
        "publicAccess": "None"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices', variables('storageName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.Security/defenderForStorageSettings",
      "apiVersion": "2025-06-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
      "name": "current",
      "properties": {
        "isEnabled": true,
        "overrideSubscriptionLevelSettings": true,
        "malwareScanning": {
          "onUpload": {
            "isEnabled": true,
            "capGBPerMonth": "[parameters('malwareScanCapGB')]"
          }
        },
        "sensitiveDataDiscovery": {
          "isEnabled": false
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('vaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[tenant().tenantId]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "enablePurgeProtection": true,
        "softDeleteRetentionInDays": 90
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('vaultName'), 'entra-client-secret')]",
      "properties": {
        "value": "[parameters('entraClientSecret')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('vaultName'), 'nextauth-secret')]",
      "properties": {
        "value": "[parameters('nextAuthSecret')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('vaultName'), 'notifications-job-token')]",
      "properties": {
        "value": "[parameters('notificationsJobToken')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('teamsNotificationWebhook')))]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('vaultName'), 'teams-notification-webhook')]",
      "properties": {
        "value": "[parameters('teamsNotificationWebhook')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[take(format('{0}-logs', parameters('appName')), 63)]",
      "location": "[parameters('location')]",
      "properties": {
        "retentionInDays": 30,
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        }
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "tags": {
        "azd-service-name": "web"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('appName')))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "NODE|22-lts",
          "appCommandLine": "node server.js",
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "alwaysOn": true,
          "healthCheckPath": "/api/health",
          "http20Enabled": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('appName')))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), resourceId('Microsoft.Web/sites', parameters('appName')), 'blob-contributor')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), resourceId('Microsoft.Web/sites', parameters('appName')), 'secrets-user')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}/{1}', parameters('appName'), 'appsettings')]",
      "properties": "[union(createObject('NODE_ENV', 'production', 'HOSTNAME', '0.0.0.0', 'WEBSITE_NODE_DEFAULT_VERSION', '~22', 'WEBSITE_RUN_FROM_PACKAGE', '1', 'SCM_DO_BUILD_DURING_DEPLOYMENT', 'false', 'ENABLE_ORYX_BUILD', 'false', 'NEXTAUTH_URL', format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName), 'NEXTAUTH_SECRET', format('@Microsoft.KeyVault(SecretUri={0}secrets/nextauth-secret/)', reference(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), '2023-07-01').vaultUri), 'ENTRA_CLIENT_ID', parameters('entraClientId'), 'ENTRA_CLIENT_SECRET', format('@Microsoft.KeyVault(SecretUri={0}secrets/entra-client-secret/)', reference(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), '2023-07-01').vaultUri), 'ENTRA_TENANT_ID', parameters('entraTenantId'), 'ADMIN_GROUP_IDS', parameters('adminGroupIds'), 'AZURE_STORAGE_ACCOUNT', variables('storageName'), 'AZURE_STORAGE_CONTAINER', 'agent-packages', 'GRAPH_AUTH_MODE', 'managed-identity', 'GRAPH_MAIL_SENDER', parameters('graphMailSender'), 'NOTIFICATIONS_JOB_TOKEN', format('@Microsoft.KeyVault(SecretUri={0}secrets/notifications-job-token/)', reference(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), '2023-07-01').vaultUri), 'REQUIRE_MALWARE_SCAN', 'true', 'DEMO_MODE', 'false', 'SEED_EXAMPLES', 'false', 'NEXT_TELEMETRY_DISABLED', '1'), if(empty(parameters('teamsNotificationWebhook')), createObject(), createObject('TEAMS_NOTIFICATION_WEBHOOK', format('@Microsoft.KeyVault(SecretUri={0}secrets/teams-notification-webhook/)', reference(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), '2023-07-01').vaultUri))))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'entra-client-secret')]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'notifications-job-token')]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageName'), 'default', 'agent-packages')]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'nextauth-secret')]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]",
        "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), resourceId('Microsoft.Web/sites', parameters('appName')), 'blob-contributor'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('vaultName'), 'teams-notification-webhook')]",
        "[resourceId('Microsoft.KeyVault/vaults', variables('vaultName'))]",
        "[extensionResourceId(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', variables('vaultName')), resourceId('Microsoft.Web/sites', parameters('appName')), 'secrets-user'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/diagnosticSettings",
      "apiVersion": "2021-05-01-preview",
      "scope": "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
      "name": "marketplace-logs",
      "properties": {
        "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', take(format('{0}-logs', parameters('appName')), 63))]",
        "logs": [
          {
            "category": "AppServiceConsoleLogs",
            "enabled": true
          },
          {
            "category": "AppServiceHTTPLogs",
            "enabled": true
          },
          {
            "category": "AppServicePlatformLogs",
            "enabled": true
          }
        ],
        "metrics": [
          {
            "category": "AllMetrics",
            "enabled": true
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', take(format('{0}-logs', parameters('appName')), 63))]"
      ]
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName)]"
    },
    "appName": {
      "type": "string",
      "value": "[parameters('appName')]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01', 'full').identity.principalId]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('vaultName')]"
    }
  }
}